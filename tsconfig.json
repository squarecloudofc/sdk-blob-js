{
	// TS 7 defaults cover the rest (strict included); tsdown owns the build output
	"compilerOptions": {
		"lib": ["DOM", "ESNext"],
		"types": ["node"],
		"module": "nodenext",
		"rewriteRelativeImportExtensions": true,
		"erasableSyntaxOnly": true,
		"skipLibCheck": true
	},
	"include": ["src", "test"]
}
