{
	"name": "@squarecloud/blob",
	"private": false,
	"version": "3.0.0",
	"description": "Official Square Cloud Blob SDK for Node.js and browsers",
	"type": "module",
	"main": "lib/index.cjs",
	"types": "lib/index.d.cts",
	"module": "lib/index.mjs",
	"exports": {
		".": {
			"import": {
				"types": "./lib/index.d.mts",
				"default": "./lib/index.mjs"
			},
			"require": {
				"types": "./lib/index.d.cts",
				"default": "./lib/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"CHANGELOG.md"
	],
	"sideEffects": false,
	"packageManager": "pnpm@12.6.0",
	"scripts": {
		"release": "pnpm build && changeset publish",
		"build": "tsdown -f cjs -f esm -d lib",
		"lint": "biome check --write .",
		"test": "node test/offline.test.ts",
		"test:live": "node --env-file=.env test/live.test.ts"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"peerDependencies": {
		"@aws-sdk/client-s3": "^3.0.0"
	},
	"peerDependenciesMeta": {
		"@aws-sdk/client-s3": {
			"optional": true
		}
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "^3.1141.0",
		"@biomejs/biome": "^2.5.14",
		"@changesets/cli": "^3.0.3",
		"@types/node": "^26.6.3",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2"
	},
	"keywords": [
		"squarecloud",
		"square",
		"cloud",
		"sdk",
		"blob",
		"api",
		"storage",
		"s3"
	],
	"author": {
		"name": "Square Cloud",
		"url": "https://squarecloud.app"
	},
	"contributors": [
		{
			"name": "João Otávio Stivi",
			"url": "https://github.com/JoaoOtavioS"
		},
		{
			"name": "João Gabriel Tonaco",
			"url": "https://github.com/joaotonaco"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/squarecloudofc/sdk-blob-js.git"
	},
	"bugs": {
		"url": "https://github.com/squarecloudofc/sdk-blob-js/issues"
	},
	"homepage": "https://github.com/squarecloudofc/sdk-blob-js#readme",
	"license": "MIT"
}
